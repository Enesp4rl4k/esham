# --- Yapay Zeka ---
GEMINI_API_KEY=buraya_gemini_api_anahtariniz_gelecek
# İsteğe bağlı model override (varsayılan: gemini-2.5-pro)
# ESHAM_GEMINI_MODEL=gemini-2.5-pro

# --- Twitter (X) API (anlık paylaşım için) ---
TWITTER_API_KEY=buraya_twitter_api_key
TWITTER_API_SECRET=buraya_twitter_api_secret
TWITTER_ACCESS_TOKEN=buraya_twitter_access_token
TWITTER_ACCESS_SECRET=buraya_twitter_access_secret

# --- Telegram (isteğe bağlı) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Uygulama ---
# Web içerik klasörü override (varsayılan: ../web/content/reports)
# ESHAM_CONTENT_DIR=
# ESHAM_SITE_URL=https://esham.com.tr
# ESHAM_LOG_LEVEL=INFO
# ESHAM_HTTP_TIMEOUT=15
# Yayın öncesi guardrail: enforce (blokla) | warn | off
# ESHAM_GUARDRAILS=enforce

# --- Anlık haber akışı (drip servis) ---
# ESHAM_NEWS_SCAN_INTERVAL=300      # kaynak tarama aralığı (sn)
# ESHAM_NEWS_PUBLISH_INTERVAL=90    # haberler arası yayın aralığı (sn)
# ESHAM_NEWS_QUEUE_MAX=200          # kuyruk kapasitesi
