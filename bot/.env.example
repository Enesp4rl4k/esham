# --- Yapay Zeka ---
# Gemini (Google AI Studio — ücretsiz tier: 1500 req/gün)
# console.cloud.google.com veya aistudio.google.com → API Keys
GEMINI_API_KEY=buraya_gemini_api_anahtariniz_gelecek
# İsteğe bağlı model override (varsayılan: gemini-2.5-flash)
# ESHAM_GEMINI_MODEL=gemini-2.5-flash
# ESHAM_TWEET_MODEL=gemini-2.5-flash-lite

# Groq (isteğe bağlı ama önerilir — ücretsiz tier: dakikada 30 req)
# console.groq.com → API Keys → ücretsiz kayıt, kredi kartı gerekmez.
# Groq aktifse tüm görevlerde primary provider olarak kullanılır; Gemini fallback kalır.
# GROQ_API_KEY=buraya_groq_api_anahtariniz_gelecek
#
# --- Groq model seçenekleri ---
# Varsayılan (kaliteli + hızlı, ücretsiz tier dahil):
# ESHAM_GROQ_MODEL=llama-3.3-70b-versatile
#
# DeepSeek R1 (Groq üzerinden — derin akıl yürütme, daha iyi analiz kalitesi):
# ESHAM_GROQ_MODEL=deepseek-r1-distill-llama-70b
#
# Diğer seçenekler: llama-3.1-70b-versatile, mixtral-8x7b-32768
#
# Tweet/filter için hızlı/ucuz model (varsayılan):
# ESHAM_GROQ_TWEET_MODEL=llama-3.1-8b-instant

# --- Twitter (X) API (anlık paylaşım için) ---
TWITTER_API_KEY=buraya_twitter_api_key
TWITTER_API_SECRET=buraya_twitter_api_secret
TWITTER_ACCESS_TOKEN=buraya_twitter_access_token
TWITTER_ACCESS_SECRET=buraya_twitter_access_secret

# --- Telegram (isteğe bağlı) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Uygulama ---
# Web içerik klasörü override (varsayılan: ../web/content/reports)
# ESHAM_CONTENT_DIR=

# Site URL — tüm rapor linkleri bu domain üzerinden üretilir.
ESHAM_SITE_URL=https://esham.pages.dev

# Kart footer'ında ve tweet'lerde görünen domain (ESHAM_SITE_URL'den otomatik türetilir,
# farklı olmasını istersen override et. Örn: "esham.pages.dev")
# ESHAM_DISPLAY_DOMAIN=esham.pages.dev

# Kart wordmark: accent renkli kısım + beyaz kısım (örn. "Pi" + "yasaBot")
# ESHAM_BRAND_ACCENT=Es
# ESHAM_BRAND_REST=ham
# Kart alt tagline
# ESHAM_BRAND_TAGLINE=YAPAY ZEKA DESTEKLİ PİYASA ANALİZİ

# ESHAM_LOG_LEVEL=INFO
# ESHAM_HTTP_TIMEOUT=15
# Yayın öncesi guardrail: enforce (blokla) | warn | off
# ESHAM_GUARDRAILS=enforce

# --- Anlık haber akışı (drip servis) ---
# ESHAM_NEWS_SCAN_INTERVAL=300      # kaynak tarama aralığı (sn)
# ESHAM_NEWS_PUBLISH_INTERVAL=90    # haberler arası yayın aralığı (sn)
# ESHAM_NEWS_QUEUE_MAX=200          # kuyruk kapasitesi
# ESHAM_KAP_MIN_IMPORTANCE=4        # genel KAP akışı önem eşiği (insider/IPO atlar)
                                     # 4: yüksek önem (temettü, birleşme, iflas vb.) — AI kota tasarrufu
                                     # 3: daha geniş kapsam — yüksek 429 riski
                                     # 5+: çok seçici — bazı önemli bildirimler kaçabilir

# --- VİOP Teminat (Takasbank) ---
# Takasbank'ın marketwide VİOP teminat özet sayfasının URL'si.
# Boş bırakılırsa MarginWatcher gerçekçi örnek verilerle çalışır (VİOP raporu yayınlanır
# ama teminat verileri gerçek değildir).
#
# Nasıl bulunur:
#   1. tarayıcıda https://www.takasbank.com.tr adresini aç
#   2. "VİOP" veya "Piyasa Verileri" bölümüne git
#   3. "Teminat Verileri" / "Garanti Fonu" / "Risk Verileri" sayfasını bul
#   4. Sayfa kaynağında veya ağ trafiğinde JSON döndüren API uç noktasını kopyala
#   5. Aşağıya yaz — bot her margin-call kontrolünde bu URL'yi çeker.
#
# Beklenen yanıt formatı (ViopSource._parse_snapshot içinde uyarlanabilir):
#   JSON nesnesinde şu alanlar aranır (veya benzer isimler):
#   - margined_account_count (int)  : teminatlı hesap sayısı
#   - margin_call_amount (float)    : toplam margin-call tutarı (TL)
#   - required_margin (float)       : gereken toplam teminat (TL)
#
# ESHAM_TAKASBANK_VIOP_URL=https://www.takasbank.com.tr/tr/api/viop/teminat-ozet

# --- Operasyonel dayanıklılık ---
# Kalıcı durum dosyası (seen-set, margin önceki değer, günlük sayaç, iş sağlığı).
# Render gibi platformlarda kalıcı disk bağlıysa restart'larda hafıza korunur.
# ESHAM_STATE_FILE=

# Acil durdurma: true yaparsan hiçbir rapor/tweet yayınlanmaz (redeploy gerekir).
# ESHAM_PAUSED=false

# Günlük paylaşım tavanı — bir hata/döngü API kotasını tüketmesin diye güvenlik ağı.
# ESHAM_MAX_POSTS_PER_DAY=60
