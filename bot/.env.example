# --- Yapay Zeka ---
GEMINI_API_KEY=buraya_gemini_api_anahtariniz_gelecek
# İsteğe bağlı model override (varsayılan: gemini-2.5-pro)
# ESHAM_GEMINI_MODEL=gemini-2.5-pro

# --- Twitter (X) API (anlık paylaşım için) ---
TWITTER_API_KEY=buraya_twitter_api_key
TWITTER_API_SECRET=buraya_twitter_api_secret
TWITTER_ACCESS_TOKEN=buraya_twitter_access_token
TWITTER_ACCESS_SECRET=buraya_twitter_access_secret

# --- Telegram (isteğe bağlı) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Uygulama ---
# Web içerik klasörü override (varsayılan: ../web/content/reports)
# ESHAM_CONTENT_DIR=

# Site URL — tüm rapor linkleri bu domain üzerinden üretilir.
ESHAM_SITE_URL=https://esham.pages.dev

# Kart footer'ında ve tweet'lerde görünen domain (ESHAM_SITE_URL'den otomatik türetilir,
# farklı olmasını istersen override et. Örn: "esham.pages.dev")
# ESHAM_DISPLAY_DOMAIN=esham.pages.dev

# Kart wordmark: accent renkli kısım + beyaz kısım (örn. "Pi" + "yasaBot")
# ESHAM_BRAND_ACCENT=Es
# ESHAM_BRAND_REST=ham
# Kart alt tagline
# ESHAM_BRAND_TAGLINE=YAPAY ZEKA DESTEKLİ PİYASA ANALİZİ

# ESHAM_LOG_LEVEL=INFO
# ESHAM_HTTP_TIMEOUT=15
# Yayın öncesi guardrail: enforce (blokla) | warn | off
# ESHAM_GUARDRAILS=enforce

# --- Anlık haber akışı (drip servis) ---
# ESHAM_NEWS_SCAN_INTERVAL=300      # kaynak tarama aralığı (sn)
# ESHAM_NEWS_PUBLISH_INTERVAL=90    # haberler arası yayın aralığı (sn)
# ESHAM_NEWS_QUEUE_MAX=200          # kuyruk kapasitesi
# ESHAM_KAP_MIN_IMPORTANCE=1        # genel KAP akışı önem eşiği (insider/IPO atlar)

# --- Operasyonel dayanıklılık ---
# Kalıcı durum dosyası (seen-set, margin önceki değer, günlük sayaç, iş sağlığı).
# Render gibi platformlarda kalıcı disk bağlıysa restart'larda hafıza korunur.
# ESHAM_STATE_FILE=

# Acil durdurma: true yaparsan hiçbir rapor/tweet yayınlanmaz (redeploy gerekir).
# ESHAM_PAUSED=false

# Günlük paylaşım tavanı — bir hata/döngü API kotasını tüketmesin diye güvenlik ağı.
# ESHAM_MAX_POSTS_PER_DAY=60
